{
  "name": "@d20dao/vrf-sdk",
  "version": "0.4.0",
  "description": "Verifiable randomness (VRF) for onchain apps: Solidity consumers, contract ABIs, USDC fee quotes and public proof replay. Live on Arc.",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./abi": {
      "types": "./dist/abi.d.ts",
      "import": "./dist/abi.js"
    },
    "./epoch": {
      "types": "./dist/epoch.d.ts",
      "import": "./dist/epoch.js"
    },
    "./abi/D20VRFCoordinator.json": "./abi/D20VRFCoordinator.json",
    "./abi/EpochEntropy.json": "./abi/EpochEntropy.json",
    "./contracts/*": "./contracts/*",
    "./examples/*": "./examples/*",
    "./AGENTS.md": "./AGENTS.md",
    "./API.md": "./API.md"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "contracts/**/*.sol",
    "examples/*.sol",
    "AGENTS.md",
    "API.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "notices/*",
    "BUILD-MANIFEST.json",
    "PROTOCOL-PROVENANCE.json",
    "abi/D20VRFCoordinator.json",
    "abi/EpochEntropy.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "api-reference": "node scripts/api-reference.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "test": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "ethers": "6.17.0"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@types/node": "24.10.0",
    "esbuild": "0.28.2",
    "solc": "0.8.28",
    "typescript": "5.9.3",
    "@openzeppelin/contracts-upgradeable": "5.6.1"
  },
  "overrides": {
    "solc": {
      "tmp": "0.2.7"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/d20dao/d20-sdk.git"
  },
  "homepage": "https://d20dao.org",
  "bugs": {
    "url": "https://github.com/d20dao/d20-sdk/issues"
  },
  "keywords": [
    "vrf",
    "verifiable-random-function",
    "verifiable-randomness",
    "randomness",
    "random-number",
    "rng",
    "oracle",
    "arc",
    "arc-network",
    "usdc",
    "solidity",
    "smart-contracts",
    "evm",
    "ethers",
    "onchain",
    "dice",
    "raffle",
    "d20dao"
  ]
}
